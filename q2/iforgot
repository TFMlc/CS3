class Publication:
    def __init__(self, title, author):
        self.title = title
        self.author = author

    def get_title(self):
        return self.title

    def get_author(self):
        return self.author

    def set_title(self, title):
        self.title = title

    def set_author(author):
        self.author = author

    def display_info(self):
        print(f"Title: {self.title}\nAuthor: {self.author}")

class Book(Publication):
    def __init__(self, title, author, number_pages):
        title = ""
        author = ""
        self.number_pages = number_pages

    def get_number_of_pages(self):
        return self.number_pages

    def set_number_of_pages(self, number_pages):
        if number_pages > 0:
            self.number_pages = number_pages
        if number_pages < 0:
            self.number_pages * -1 == number_pages
            
            

class Magazine(Publication):
    def __init__(self, title, author, issue_number):
        self.title = title
        self.author = author
        self.issue_number = issue_number

    def get_issue_number():
        return self.issue_number

    def set_issue_number(issue_number):
        if issue_number > 0:
            self.issue_number = issue_number
        if issue_number < 0:
            self.issue_number * -1 == issue_number

pub1 = Publication("Journal of Experimental Psychology", "Ratchiff, R. & Van Dongen, H.")
book1 = Book("The Hobbit", "J.R.R. Tolkien", 310)
mag1 = Magazine("National Geographic", "Various Authors", 202)

print("Pubic Information:")
pub1.display_info()

print("\nBook Information:")
book1.set_number_of_pages(-310)
book1.display_info()
print(book1.get_number_of_pages())

print("\nMagazine Information:")
mag1.display_info()
print(mag1.get_issue_number())
